#include<stdio.h>
#include<stdlib.h>
struct node
{
	int data;
	struct node *next;
};
struct node *add_beg(struct node*head,int d)
{
	struct node *newnode =(struct node*)malloc(sizeof(struct node));
	newnode->data=d;
	newnode ->next=NULL;
	
	newnode ->next=head;
	head=newnode;
	return head;
} 
int main()
{
	struct node* head = (struct node*)malloc(sizeof(struct node));
	head->data = 45;
	head->next=NULL;
	struct node* ptr = (struct node*)malloc(sizeof(struct node));
	
	ptr->data= 98;
	ptr->next=NULL;
	
	head->next=ptr;
	
	int data=3;
	head = add_beg(head,data);
	ptr=head;
	
	while(ptr!=NULL)
	{
		printf(" %d",ptr->data);
		ptr = ptr->next;
	}
	return 0;
}

