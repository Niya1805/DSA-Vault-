#include<stdio.h>
#include<stdlib.h>
struct node{
	int data;
	struct node *next;
};
struct node* del_last(struct node *head)
{
	struct node *p=head;
	struct node *p2=head;
	while(p->next!=NULL)
	{
		p2=p;
		p=p->next;
	}
	p2->next=NULL;
	free(p);
	return head;
}
int main()
{
	struct node* head = (struct node*)malloc(sizeof(struct node));
	head->data = 45;
	head->next=NULL;
	struct node *second = (struct node*)malloc(sizeof(struct node));
	second->data=3;
	second->next=NULL;
	struct node* third = (struct node*)malloc(sizeof(struct node));
	third->data= 98;
	third->next=NULL;
	
	head->next=second;
	second->next=third; //connect nodes
	
	head = del_last(head);
	struct node *temp = head;
	
	while(temp!=NULL)
	{
		printf(" %d",temp->data);
		temp = temp->next;
	}
	return 0;

}

