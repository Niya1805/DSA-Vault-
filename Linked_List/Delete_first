#include<stdio.h>
#include<stdlib.h>
struct node{
	int data;
	struct node *next;
};
struct node *del_first(struct node *head)
{
	if(head==NULL)
	{
		printf("List empty");
	}
	else
	{
	struct node *p = head;
	head= head->next;
	free(p);
	return head;}
}
int main()
{
	struct node* head = (struct node*)malloc(sizeof(struct node));
	head->data = 45;
	head->next=NULL;
	struct node* second = (struct node*)malloc(sizeof(struct node));
	
	second->data= 98;
	second->next=NULL;
	
	head->next=second; //connect nodes
	
	head = del_first(head);
	struct node *temp = head;
	
	while(temp!=NULL)
	{
		printf(" %d",temp->data);
		temp = temp->next;
	}
	return 0;
}
