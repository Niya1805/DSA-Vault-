#include <stdio.h>

int main()
{
    int n, i, max, exp;
    int a[100], output[100], count[10];

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    max = a[0];
    for(i = 1; i < n; i++)
        if(a[i] > max)
            max = a[i];

    for(exp = 1; max/exp > 0; exp *= 10)
    {
        for(i = 0; i < 10; i++)
            count[i] = 0;

        for(i = 0; i < n; i++)
            count[(a[i]/exp)%10]++;

        for(i = 1; i < 10; i++)
            count[i] += count[i-1];

        for(i = n-1; i >= 0; i--)
        {
            output[count[(a[i]/exp)%10] - 1] = a[i];
            count[(a[i]/exp)%10]--;
        }

        for(i = 0; i < n; i++)
            a[i] = output[i];
    }

    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
