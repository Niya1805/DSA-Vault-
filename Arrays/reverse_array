#include<stdio.h>
int main()
{
	int a[10],n,i,j,temp;
	printf("Enter no of elements");
	scanf("%d",&n);
	printf("Enter those n elements");
	for(i=0;i<n;i++)
		scanf("%d",&a[i]);
	printf("Numbers in reverse order");
	for(i=0,j=n-1;i<n/2;i++,j--)
	{
		temp=a[i];
		a[i]=a[j];
		a[j]=temp;
	}
	for(i=0;i<n;i++)
	{
		printf("%d",a[i]);
	}
return 0;
}
