#include<stdio.h>
int main()
{
	int n,i,a[100],output[100];
	printf("Enter n elements");
	scanf("%d",&n);
	printf("Enter elements");
	for(i=0;i<n;i++)
	{
		scanf("%d",&a[i]);
	}
	int max=a[0];
	for(i=0;i<n;i++)
	{
		if(a[i]>max)
		{
			max=a[i];
		}
	}
	int count[max+1];
	for(i=0;i<=max;i++)
	{
		count[i]=0;
		
	}
	for(i=0;i<n;i++)
	{
		count[a[i]]++; //check frequency
	}
	for(i=1;i<=max;i++)
	{
		count[i]+=count[i-1];
	}
	for(i=n-1;i>=0;i--)
	{
		output[count[a[i]]-1]=a[i];
		count[a[i]]--;
	}
	printf("Sorted array");
	for(i=0;i<n;i++)
	{
		printf("%d",output[i]);
	}
	return 0;
	
}
