#include <stdio.h>

int main() {
    printf("Enter number of elements");
    int arr[] = {2, 5, 8, 12, 16, 23, 38, 56, 72, 91};
    int n = sizeof(arr) / sizeof(arr[0]); // Calculates the number of elements
    int target = 23;                       // The element we want to find
    
    int low = 0;
    int high = n - 1;
    int mid;
    int found_index = -1; // Stores the index if found, remains -1 if not found

    // 2. Binary Search Logic
    while (low <= high) {
        // Calculate the middle index (prevents potential integer overflow)
        mid = low + (high - low) / 2;

        // Check if the target is present at mid
        if (arr[mid] == target) {
            found_index = mid;
            break; // Element found, exit the loop
        }
        // If target is greater, ignore the left half
        else if (arr[mid] < target) {
            low = mid + 1;
        }
        // If target is smaller, ignore the right half
        else {
            high = mid - 1;
        }
    }

    // 3. Print the result
    if (found_index != -1) {
        printf("Element %d found at index %d.\n", target, found_index);
    } else {
        printf("Element %d not found in the array.\n", target);
    }

    return 0;
}
