#include<stdio.h>
int main()
{
	int n,i,pos,a[100];
	printf("Enter number of elements");
	scanf("%d",&n);
  
	printf("Enter those elements");
	for(i=0;i<n;i++)
	scanf("%d",&a[i]);
  
	printf("Enter position at which element needs to be deleted");
	scanf("%d",&pos);
  
	for(i=pos-1;i<n-1;i++)
	a[i]=a[i+1];
	n=n-1;
	for(i=0;i<n;i++)
	printf("%d",a[i]);
}
